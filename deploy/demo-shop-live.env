# Local demo only: these credentials exist only in compose.yaml's throwaway Postgres.
# The demo shop answered by the real model (Gemini on Vertex AI), for test messages only.
# Same database and embedder as demo-shop.env, so the knowledge bootstrap-demo loaded still
# matches. The Google Cloud project is not stored here: it comes from FRONTDESK_GCP_PROJECT, which
# you set in your shell for each run.
FRONTDESK_BUSINESS_PACK=businesses/demo-shop
FRONTDESK_DATABASE_URL=postgresql+psycopg://frontdesk_app:frontdesk_app@localhost:5432/frontdesk_shop
FRONTDESK_MIGRATION_DATABASE_URL=postgresql+psycopg://frontdesk:frontdesk@localhost:5432/frontdesk_shop
FRONTDESK_MODEL_ROUTE=vertex-eu-gemini-flash-lite
FRONTDESK_EMBEDDING_BACKEND=hash
