# One deployment = one business. Real deployments copy this file to deploy/<business>.env.
FRONTDESK_BUSINESS_PACK=businesses/demo-clinic
FRONTDESK_DATABASE_URL=postgresql+psycopg://frontdesk_app:frontdesk_app@localhost:5432/frontdesk_clinic
FRONTDESK_MIGRATION_DATABASE_URL=postgresql+psycopg://frontdesk:frontdesk@localhost:5432/frontdesk_clinic
FRONTDESK_MODEL_ROUTE=offline-demo
# FRONTDESK_GCP_PROJECT=your-gcp-project   # only for live routes (ADR-0004)
# Who leads the conversation on a live route: pipeline, or agent (a model with tools, checked by code).
FRONTDESK_CONVERSATION=pipeline
FRONTDESK_EMBEDDING_BACKEND=hash
FRONTDESK_MIN_SUPPORT_SIMILARITY=0.5
FRONTDESK_MIN_RETRIEVAL_SIMILARITY=0.0
# Where the bookable doctors' free slots are read (ADR-0003): none, fixture (a YAML file for tests
# and evaluations), google (the doctors' Google Calendars) or calcom (cal.com's event types).
FRONTDESK_CALENDAR_BACKEND=none
# FRONTDESK_CALENDAR_FIXTURE=evals/calendar.yaml
# FRONTDESK_CALENDAR_IMPERSONATE=calendar-reader@your-gcp-project.iam.gserviceaccount.com   # on the Mac
# FRONTDESK_CALCOM_API_KEY=...   # in the environment only, never in a committed file
# FRONTDESK_CALCOM_BASE_URL=https://api.cal.com
FRONTDESK_TELEMETRY_CAPTURE_CONTENT=false
FRONTDESK_LOG_LEVEL=INFO
# Production's guards on the model (ADR-0004): a cap on each day's spend, priced from a prices file
# in the live runs' budget format, and a switch that turns the model off.
# FRONTDESK_DAILY_CAP_EUR=5
# FRONTDESK_PRICES_FILE=deploy/prices.yaml
FRONTDESK_MODEL_OFF=false
# Where secrets come from (frontdesk.secrets): env in development, gcp (Secret Manager) in production,
# where a key in the environment is refused.
FRONTDESK_SECRETS_BACKEND=env
# FRONTDESK_SECRETS_PROJECT=your-gcp-project
